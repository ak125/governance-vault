+import copy
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+import collect
+
+A='a'*64
+B='b'*64
+C='c'*64
+
+def source(records, project='automecanik', **extra):
+    return {'id':'s','project':project,'role':'wiki','root':'/wiki',
+            'records':records, **extra}
+
+def row(path='wiki/a.md', sha=A, family='wiki', **extra):
+    return {'path':path,'sha256':sha,'family':family,'title':'Test',
+            'declared':{},'trust':'source_declaration_not_revalidated',
+            'business_pool_admissible':False,**extra}
+
+def run(sources):return {'checked_at':'2026-09-13T06:00:00Z','sources':sources}
+
+class CatalogueTests(unittest.TestCase):
+    def test_identical_body_keeps_multiple_provenances_without_approval(self):
+        data=run({'a':source([row()]),'b':source([row(family='consumer_copy',declared={'status':'approved'})])})
+        result=collect.catalogue(data)
+        self.assertEqual(result['unique_contents'],1)
+        self.assertEqual(result['occurrences'],2)
+        card=result['contents'][0]
+        self.assertEqual(card['families'],['consumer_copy','wiki'])
+        self.assertEqual(len(card['origins']),2)
+        self.assertEqual(card['qualification'],'not_evaluated')
+
+    def test_exclusive_buckets_reconcile_and_projects_do_not_merge(self):
+        data=run({'a':source([row(),row('b.md',B,'raw')]),'b':source([row(sha=C)],project='alliance')})
+        result=collect.catalogue(data)
+        self.assertEqual(sum(x['contents'] for x in result['family_combinations']),3)
+        self.assertEqual({x['project']:x['contents'] for x in result['projects']},{'alliance':1,'automecanik':2})
+
+    def test_duplicate_identity_or_invalid_hash_rejected(self):
+        with self.assertRaises(ValueError):collect.catalogue(run({'a':source([row(),row()])}))
+        with self.assertRaises(ValueError):collect.catalogue(run({'a':source([row(sha='../unsafe')])}))
+
+    def test_changes_keep_modification_and_reclassification_separate(self):
+        old=run({'a':source([row(),row('b.md',B),row('gone.md',C)])})
+        new=copy.deepcopy(old);new['sources']['a']['records']=[row(sha=B),row('b.md',B,declared={'status':'draft'}),row('added.md',C)]
+        result=collect.catalogue(new,old)['changes']
+        self.assertEqual(result['counts'],{'added':1,'removed':1,'modified':1,'metadata_changed':1,'unchanged':0})
+
+    def test_failed_or_removed_source_never_becomes_file_deletion(self):
+        old=run({'a':source([row()]),'b':source([row()])})
+        new=run({'a':source([],error='Timeout')})
+        changes=collect.catalogue(new,old)['changes']
+        self.assertEqual(changes['counts']['removed'],0)
+        self.assertEqual(len(changes['uncompared_sources']),2)
+
+    def test_configuration_change_and_first_run_are_not_new_findings(self):
+        old=run({'a':source([row()])});new=run({'a':source([row()],project='alliance')})
+        result=collect.catalogue(new,old)['changes']
+        self.assertEqual(result['counts']['added'],0)
+        self.assertEqual(result['uncompared_sources'][0]['reason'],'source_configuration_changed')
+        self.assertEqual(collect.catalogue(new)['changes']['counts']['added'],0)
+
+    def test_timestamp_only_does_not_change_document(self):
+        old=run({'a':source([row(mtime_ns=1)])});new=copy.deepcopy(old)
+        new['sources']['a']['records'][0]['mtime_ns']=999
+        result=collect.catalogue(new,old)['changes']
+        self.assertEqual(result['counts']['unchanged'],1)
+
+    def test_render_metadata_only_with_native_base_and_retained_missing_card(self):
+        with tempfile.TemporaryDirectory() as d,patch.object(collect,'STORE',Path(d)):
+            data=run({'a':source([row(title='[untrusted](https://bad.invalid)<script>')])})
+            collect.render_catalogue(collect.catalogue(data))
+            base=Path(d)/'navigation/catalogue'
+            card=base/'Contenus'/f'{A}.md'
+            text=card.read_text()
+            self.assertIn('not_evaluated',text)
+            self.assertNotIn('<script>',text.split('---',2)[-1])
+            config=json.loads((base/'Catalogue.base').read_text())
+            self.assertEqual(config['views'][0]['type'],'table')
+            self.assertFalse((Path(d)/'objects').exists())
+            collect.render_catalogue(collect.catalogue(run({}),data))
+            self.assertIn('"unobserved"',card.read_text())
+            self.assertTrue(card.exists())
+
+    def test_same_projection_does_not_rewrite_cards(self):
+        with tempfile.TemporaryDirectory() as d,patch.object(collect,'STORE',Path(d)):
+            index=collect.catalogue(run({'a':source([row()])}))
+            collect.render_catalogue(index)
+            card=Path(d)/'navigation/catalogue/Contenus'/f'{A}.md'
+            before=card.stat().st_mtime_ns
+            collect.render_catalogue(index)
+            self.assertEqual(card.stat().st_mtime_ns,before)
+
+    def test_source_failure_retains_observed_rows_with_incomplete_label(self):
+        result=collect.catalogue(run({'a':source([row()],errors=[{'error':'partial'}])}))
+        self.assertEqual(result['unique_contents'],1)
+        self.assertTrue(result['contents'][0]['origins'][0]['source_incomplete'])
+        self.assertIn('a',result['source_errors'])
+
+    def test_tampered_previous_card_path_is_refused(self):
+        with tempfile.TemporaryDirectory() as d,patch.object(collect,'STORE',Path(d)):
+            path=Path(d)/'navigation/catalogue/catalogue.json'
+            path.parent.mkdir(parents=True)
+            path.write_text(json.dumps({'contents':[{'sha256':'../outside'}]}))
+            with self.assertRaises(ValueError):
+                collect.render_catalogue(collect.catalogue(run({})))
