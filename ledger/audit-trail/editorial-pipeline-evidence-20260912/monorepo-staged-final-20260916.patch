+    vi.spyOn(globalThis, "fetch").mockImplementation(async (input) => {
+      const path = new URL(String(input)).pathname;
+      if (path.includes("/redirect/")) return Response.json(null);
+      if (path.includes("/api/blog/guides/slug/"))
