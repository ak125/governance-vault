+afterEach(() => vi.restoreAllMocks());
+const args = {
+  params: { pg_alias: "filtre-a-huile" },
+  request: new Request(
+    "https://fixture.invalid/blog-pieces-auto/guide-achat/filtre-a-huile",
+  ),
+  context: new RouterContextProvider(),
+  url: new URL(
+    "https://fixture.invalid/blog-pieces-auto/guide-achat/filtre-a-huile",
