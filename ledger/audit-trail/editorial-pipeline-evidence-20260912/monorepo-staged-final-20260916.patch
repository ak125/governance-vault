+
+  it('a confirmed active write enqueues without relying on backlog lookup', async () => {
+    const f = recovery(false, { entitiesWritten: 1 });
+    await expect(f.processor.handle(job)).resolves.toMatchObject({
+      refreshEnqueued: true,
+    });
