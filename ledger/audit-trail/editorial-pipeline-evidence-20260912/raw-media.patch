+def probe_video(media_path: Path, extension: str) -> dict:
+    """Inspect a local container in a network-isolated namespace, with local protocols only."""
+    binary = os.environ.get("RAW_FFPROBE_BIN", "")
+    if not Path(binary).is_absolute():
+        raise RuntimeError("qualified_ffprobe_not_configured")
+    args = ["unshare", "--user", "--map-root-user", "--net", "--fork", "--kill-child=KILL",
+            binary, "-v", "error", "-threads", "1", "-max_alloc", "67108864",
+            "-probesize", "8388608", "-analyzeduration", "5000000",
+            "-protocol_whitelist", "file,pipe", "-format_whitelist", "mov,matroska,webm"]
+    if extension in ("mp4", "mov"):
+        args += ["-enable_drefs", "0", "-use_absolute_path", "0"]
+    args += ["-show_entries", "format=format_name,duration:stream=codec_type,codec_name,width,height",
+             "-of", "json", "-i", str(media_path)]
+    with tempfile.TemporaryDirectory(prefix="raw-media-probe-") as tmp:
+        output = Path(tmp) / "probe.json"
+        with output.open("wb") as stdout, (Path(tmp) / "probe.err").open("wb") as stderr:
+            result = subprocess.run(args, stdout=stdout, stderr=stderr, timeout=12, check=False,
+                                    preexec_fn=_probe_limits,
+                                    env={"PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+                                         "LANG": "C.UTF-8", "OPENBLAS_NUM_THREADS": "1", "OMP_NUM_THREADS": "1"})
+        if result.returncode:
+            raise ValueError("video_container_probe_refused")
+        metadata = json.loads(output.read_text(encoding="utf-8"))
+    duration = float(metadata.get("format", {}).get("duration", "nan"))
+    formats = set(metadata.get("format", {}).get("format_name", "").split(","))
+    expected = {"mov", "mp4"} if extension in ("mp4", "mov") else {"matroska", "webm"}
+    streams = [stream for stream in metadata.get("streams", []) if stream.get("codec_type") == "video"]
+    if (not formats.intersection(expected) or not math.isfinite(duration)
+            or not 0 < duration <= MAX_VIDEO_DURATION_S or not 1 <= len(streams) <= 4):
+        raise ValueError("video_container_limits_refused")
+    video_streams = []
+    for stream in streams:
+        width, height = stream.get("width", 0), stream.get("height", 0)
+        if not isinstance(width, int) or not isinstance(height, int) or not (width > 0 and height > 0 and width * height <= MAX_VIDEO_PIXELS):
+            raise ValueError("video_dimensions_refused")
+        codec = stream.get("codec_name", "")
+        if not re.fullmatch(r"[a-z0-9_]{1,32}", codec):
+            raise ValueError("video_codec_unknown")
+        if extension == "webm" and codec not in ("vp8", "vp9", "av1"):
+            raise ValueError("webm_codec_mismatch")
+        video_streams.append({"codec": codec, "width": width, "height": height})
+    return {"duration_sec": duration, "video_streams": video_streams}
