+    resource.setrlimit(resource.RLIMIT_FSIZE, (64 * 1024,) * 2)
+    resource.setrlimit(resource.RLIMIT_NOFILE, (64, 64))
+    if ctypes.CDLL(None).prctl(1, signal.SIGKILL, 0, 0, 0) != 0:
