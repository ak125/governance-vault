+def test_url_capture_native_inventory_and_failed_refresh_replay(producer, monkeypatch):
+    r, root = producer
+    url = 'https://www.bosch.com/technical'
+    item = {'id': 'fixture-item', 'gamme': 'filtre'}
+    al = {'allow': {'bosch.com': {'level': 2, 'source_type': 'product_catalog', 'license_status': 'unknown'}}, 'deny': {}}
+    monkeypatch.setattr(r, 'fetch', lambda *_args, **_kwargs: '<p>' + 'Texte de fixture technique avec 12 particules. ' * 10 + '</p>')
+    with monkeypatch.context() as patcher:
+        patcher.setattr(r, 'refresh_submission_manifests', lambda: (_ for _ in ()).throw(RuntimeError('manifest fixture')))
+        failed = r.capture_one(url, item, al, commit=True, rate_limit=0)
+    assert failed['action'] == 'ERROR'
+    capture = next((root / 'sources/auto-captures').rglob('*.md'))
+    original = capture.read_bytes(), capture.stat().st_mtime_ns
+    retried = r.capture_one(url, item, al, commit=True, rate_limit=0)
+    assert retried['action'] == 'SKIP' and retried['detail'] == 'duplicate_content_hash'
+    assert retried['raw_path'] == capture.relative_to(root).as_posix()
+    assert retried['status'] == 'CAPTURED_NEEDS_REVIEW'
+    assert (capture.read_bytes(), capture.stat().st_mtime_ns) == original
+    assert capture.relative_to(root).as_posix() in json.loads((root / 'manifests/checksums.json').read_text())
+
+
+def test_url_capture_secret_scan_refuses_before_persistence(producer, monkeypatch):
+    r, root = producer
+    monkeypatch.setattr(r, 'fetch', lambda *_args, **_kwargs: '<p>' + 'Texte de fixture technique avec 12 particules. ' * 10 + '</p>')
+    monkeypatch.setattr(r, 'check_submission_secrets', lambda _: (_ for _ in ()).throw(ValueError('secret fixture')))
+    al = {'allow': {'bosch.com': {'level': 2, 'source_type': 'product_catalog', 'license_status': 'unknown'}}, 'deny': {}}
+    result = r.capture_one('https://www.bosch.com/technical', {'id': 'fixture', 'gamme': 'filtre'}, al, commit=True, rate_limit=0)
+    assert result['action'] == 'ERROR' and not (root / 'sources').exists()
+
+
+def test_main_retries_worklist_write_after_duplicate_receipt(producer, monkeypatch, capsys):
+    r, root = producer
+    item = {'id': 'fixture-item', 'gamme': 'filtre', 'discovery': {'mode': 'provided'}}
+    r.WORKLIST_FILE.write_text('fixture-placeholder')
+    monkeypatch.setattr(r, '_load_yaml', lambda _: {'worklist': [item]})
+    monkeypatch.setattr(r, 'load_allowlist', lambda: {})
+    receipt = {'action': 'SKIP', 'detail': 'duplicate_content_hash', 'raw_path': 'sources/auto-captures/fixture.md',
+               'url': 'https://www.bosch.com/source', 'status': 'CAPTURED_NEEDS_REVIEW',
+               'content_hash': 'sha256:' + 'b' * 64, 'captured_at': '2026-09-12T00:00:00Z',
+               'source_type': 'product_catalog', 'license_status': 'unknown'}
+    monkeypatch.setattr(r, 'capture_one', lambda *_args, **_kwargs: receipt)
+    monkeypatch.setattr(r.sys, 'argv', ['capture', '--item', item['id'], '--url', receipt['url'], '--commit', '--json'])
+    calls = []
+    def update(wid, **kwargs):
+        calls.append(wid)
+        if len(calls) == 1:
+            raise OSError('fixture failure')
+        return True
+    monkeypatch.setattr(r, 'update_worklist_item', update)
+    assert r.main() == 1
+    assert json.loads(capsys.readouterr().out)['worklist_updated'].startswith('FAILED:')
+    assert r.main() == 0
+    assert json.loads(capsys.readouterr().out)['worklist_updated'] == item['id']
+    assert calls == [item['id'], item['id']]
