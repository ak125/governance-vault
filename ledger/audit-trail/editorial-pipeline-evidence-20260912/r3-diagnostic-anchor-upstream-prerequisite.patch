+
+    await service.getR3GuidePayload(PG_ALIAS);
+
+    const cached = await cache.get<{ metaSections: unknown[] }>(
+      `r3-guide:v3:${PG_ALIAS}`,
+    );
+    expect(cached?.metaSections).toEqual([]);
+    expect(await cache.get(`r3-guide:v2:${PG_ALIAS}`)).toBeNull();
+  });
+});
