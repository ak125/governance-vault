+      async (s: string) =>
+        s.replace(
+          '#LinkGamme_402#',
+          '<a href="/pieces/plaquette-de-frein-402.html">plaquettes de frein</a>',
+        ),
+    );
+    seoService.getGammeConseil.mockResolvedValue([
+      body,
+      meta('Pour aller plus loin', 'Voir aussi nos #LinkGamme_402#.'),
