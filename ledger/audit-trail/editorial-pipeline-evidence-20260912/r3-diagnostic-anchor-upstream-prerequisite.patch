+  it('aucune section écartée : aucun journal', async () => {
+    const { service, seoService } = await buildService();
+    seoService.getGammeConseil.mockResolvedValue([body, LINKS_META]);
+    const warn = jest.spyOn((service as any).logger, 'warn');
