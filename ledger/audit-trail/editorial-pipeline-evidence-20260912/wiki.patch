 def count_filled_sections(body: str, required: list[str]) -> int:
-    headings = [h.lower() for h in H2_RE.findall(body)]
+    headings = list(H2_RE.finditer(body))
     filled = 0
     for sec in required:
         sec_low = sec.lower()
