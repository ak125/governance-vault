+"""RAW admin text intake: real schema, manifests and append-only files in temp git."""
+import importlib.util
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).parents[2]
+
+
+@pytest.fixture
+def producer(tmp_path, monkeypatch):
+    # Load code from a disposable copy so the native manifest generator also runs
+    # against fixtures only. No corpus or Git remote is accessed.
+    shutil.copytree(ROOT / '_scripts', tmp_path / '_scripts', ignore=shutil.ignore_patterns('__pycache__'))
+    shutil.copytree(ROOT / '_schemas', tmp_path / '_schemas')
+    (tmp_path / 'manifests').mkdir()
+    subprocess.run(['git', 'init', '-q', str(tmp_path)], check=True)
+    spec = importlib.util.spec_from_file_location('submission_runner', tmp_path / '_scripts/auto-capture-runner.py')
+    runner = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(runner)
+    monkeypatch.setattr(runner, 'check_submission_secrets', lambda _: None)
+    return runner, tmp_path
+
+
+def document(**extra):
+    return {'title': 'Entretien du filtre', 'content': 'Texte soumis : remplacer le filtre selon le plan du constructeur.\n',
+            'source': 'manual/filtre', 'source_url': 'https://manufacturer.example/filtre', **extra}
+
+
+def test_submission_keeps_body_and_declared_provenance_without_authority(producer):
+    r, root = producer
+    doc = document()
+    result = r.ingest_admin_submission(doc, commit=True)
+    assert result['action'] == 'RECEIVED'
+    assert result['status'] == 'to_verify'
+    assert result['retrievable'] is False
+    text = (root / result['raw_path']).read_text()
+    fm = r._gates._split_frontmatter(text)
+    assert text.endswith(doc['content'])
+    assert fm['truth_level'] == 'L4'
+    assert fm['source_url_verified'] is False
+    assert fm['origin_type'] == 'admin_submission'
+    assert fm['can_feed_chatbot_directly'] is False
+    assert fm['can_feed_content_directly'] is False
+    # The actual Gate A and generator check consume the persisted bytes.
+    assert r._gates.gate_recycled_frontmatter() == ([], 1)
+    check = subprocess.run(['python3', str(root / '_scripts/regen-manifests.py'), '--check'], capture_output=True)
+    assert check.returncode == 0, check.stderr
+    assert result['raw_path'] in json.loads((root / 'manifests/checksums.json').read_text())
+
+
+def test_same_canonical_url_and_body_preserve_receipt_and_file(producer):
+    r, root = producer
+    first = r.ingest_admin_submission(document(source_url='https://MANUFACTURER.example:443/filtre#one'), commit=True)
+    path = root / first['raw_path']
+    before, stamp = path.read_bytes(), path.stat().st_mtime_ns
+    second = r.ingest_admin_submission(document(source_url='https://manufacturer.example/filtre#two'), commit=True)
+    assert second['id'] == first['id']
+    assert second['duplicate'] is True
+    assert path.read_bytes() == before and path.stat().st_mtime_ns == stamp
+    assert len(list((root / 'recycled').rglob('*.md'))) == 1
+
+
+def test_changed_body_creates_immutable_new_version(producer):
+    r, root = producer
+    first = r.ingest_admin_submission(document(), commit=True)
+    before = (root / first['raw_path']).read_bytes()
+    second = r.ingest_admin_submission(document(content='Autre texte technique.'), commit=True)
+    assert second['id'] != first['id']
+    assert (root / first['raw_path']).read_bytes() == before
+    assert len(list((root / 'recycled').rglob('*.md'))) == 2
+
+
+@pytest.mark.parametrize('update', [
+    {'truth_level': 'L1'}, {'decision': {'proposed': {'retrievable': True}}},
+    {'content': ''}, {'content': 'person@example.com'}, {'source_url': 'http://example.com'},
+    {'source_url': 'https://user:pass@example.com'}, {'title': None},
+])
+def test_invalid_or_authority_bearing_submission_never_written(update, producer):
+    r, root = producer
+    with pytest.raises((ValueError, TypeError)):
+        r.ingest_admin_submission(document(**update), commit=True)
+    assert not (root / 'recycled').exists()
+
+
+def test_missing_schema_and_secret_scan_failure_prevent_write(producer, monkeypatch):
+    r, root = producer
+    with monkeypatch.context() as patcher:
+        patcher.setattr(r._gates, 'RECYCLED_FM_SCHEMA', root / 'absent.json')
+        with pytest.raises(FileNotFoundError):
+            r.ingest_admin_submission(document(), commit=True)
+    monkeypatch.setattr(r, 'check_submission_secrets', lambda _: (_ for _ in ()).throw(ValueError('secret')))
+    with pytest.raises(ValueError):
+        r.ingest_admin_submission(document(), commit=True)
+    assert not (root / 'recycled').exists()
+
+
+def test_failed_manifest_refresh_never_reports_success_and_retry_repairs(producer, monkeypatch):
+    r, root = producer
+    with monkeypatch.context() as patcher:
+        patcher.setattr(r, 'refresh_submission_manifests', lambda: (_ for _ in ()).throw(ValueError('manifest failed')))
+        with pytest.raises(ValueError):
+            r.ingest_admin_submission(document(), commit=True)
+    assert len(list((root / 'recycled').rglob('*.md'))) == 1
+    repaired = r.ingest_admin_submission(document(), commit=True)
+    assert repaired['action'] == 'RECEIVED' and repaired['duplicate'] is True
+    assert repaired['raw_path'] in json.loads((root / 'manifests/checksums.json').read_text())
+
+
+def test_plan_is_offline_and_does_not_write(producer, monkeypatch):
+    r, root = producer
+    monkeypatch.setattr(r, 'check_submission_secrets', lambda _: pytest.fail('scanner in plan'))
+    assert r.ingest_admin_submission(document(), commit=False)['action'] == 'PLAN'
+    assert not (root / 'recycled').exists()
+    assert not list((root / 'manifests').iterdir())
+
+
+def test_symlink_escape_and_receipt_collision_refused(producer):
+    r, root = producer
+    result = r.ingest_admin_submission(document(), commit=False)
+    (root / 'recycled').mkdir()
+    (root / 'escape').mkdir()
+    (root / 'recycled/admin-submissions').symlink_to(root / 'escape', target_is_directory=True)
+    with pytest.raises(ValueError, match='path_escape'):
+        r.ingest_admin_submission(document(), commit=True)
+    assert not list((root / 'escape').iterdir())
+
+
+def test_busy_producer_lock_prevents_second_writer(producer):
+    import fcntl
+    r, root = producer
+    with (root / '.git/raw-admin-acquisition.lock').open('a') as held:
+        fcntl.flock(held, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        with pytest.raises(BlockingIOError):
+            r.ingest_admin_submission(document(), commit=True)
+    assert not (root / 'recycled').exists()
