+    monkeypatch.setattr(runner, 'AUTO_CAPTURES_DIR', tmp_path / 'sources' / 'auto-captures')
+    wire[0].extend([robots(), Response(b'%PDF-1.7 fake HTML')])
+    al = {'allow': {'manufacturer.example': {'level': 2, 'license_status': 'unknown',
+                                            'source_type': 'technical_datasheet'}}, 'deny': {}}
