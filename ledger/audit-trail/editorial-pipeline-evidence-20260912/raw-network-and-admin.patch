+
+
+def test_runner_network_to_gate_j_persistence_and_duplicate(wire, monkeypatch, tmp_path):
+    spec = importlib.util.spec_from_file_location('runner_full_test', Path(__file__).parents[1] / 'auto-capture-runner.py')
+    runner = importlib.util.module_from_spec(spec)
