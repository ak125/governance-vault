+"""Offline adversarial tests; no DNS, TLS or HTTP request reaches the network."""
+import importlib.util
+import io
+import socket
+from email.message import Message
+from pathlib import Path
+from unittest.mock import Mock
+
+import pytest
+
+_spec = importlib.util.spec_from_file_location('capture_http_test', Path(__file__).parents[1] / 'capture_http.py')
+h = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(h)
+URL = 'https://manufacturer.example/article'
+PUBLIC = (socket.AF_INET, socket.SOCK_STREAM, 6, '', ('93.184.216.34', 443))
+
+
+class Response:
+    def __init__(self, body=b'<html><p>Technical information 123.</p></html>', status=200, mime='text/html', **headers):
+        self.status = status
+        self.headers = Message()
+        if mime is not None:
+            self.headers['Content-Type'] = mime
+        for key, value in headers.items():
+            self.headers[key.replace('_', '-')] = str(value)
+        self.stream = io.BytesIO(body)
+        self.read_sizes = []
+
+    def getheader(self, name, default=None):
+        return self.headers.get(name, default)
+
+    def read1(self, size):
+        self.read_sizes.append(size)
+        return self.stream.read(size)
+
+
+@pytest.fixture
+def wire(monkeypatch):
+    dns = Mock(return_value=[PUBLIC])
+    monkeypatch.setattr(h.socket, 'getaddrinfo', dns)
+    replies, connections = [], []
+
+    class Connection:
+        def __init__(self, host, address, timeout):
+            self.host, self.address = host, address
+            self.sock = Mock()
+            self.closed = False
+            connections.append(self)
+
+        def request(self, method, path, headers):
+            self.path = path
+            self.headers = headers
+
+        def getresponse(self):
+            assert replies, 'unexpected HTTP request'
+            return replies.pop(0)
+
+        def close(self):
+            self.closed = True
+
+    monkeypatch.setattr(h, '_PinnedHTTPSConnection', Connection)
+    monkeypatch.setattr(h.time, 'sleep', lambda _: None)
+    return replies, connections, dns
+
+
+def transport():
+    return h.Transport(lambda url: 'manufacturer.example' == h.urlsplit(url).hostname, 'capture-test', 2)
+
+
+def robots(body=b'User-agent: *\nAllow: /\n', **kw):
+    return Response(body, mime='text/plain', **kw)
+
+
+@pytest.mark.parametrize('url', [
+    'http://manufacturer.example/x', 'file:///etc/passwd',
+    'https://user:pass@manufacturer.example/', 'https://manufacturer.example:8080/',
+    'https://manufacturer.example/\r\nHeader:evil', 'https://manufacturer.example\\@evil.example/',
+    'https://evil.example/x', 'https://manufacturer.example:bad/',
+])
+def test_invalid_targets_never_connect(url, wire):
+    replies, connections, dns = wire
+    with pytest.raises(h.CaptureHTTPError):
+        transport().fetch_html(url)
+    assert not connections
+    dns.assert_not_called()
+
+
+@pytest.mark.parametrize('ip', ['127.0.0.1', '10.0.0.1', '169.254.169.254', '100.100.100.200',
+                                    '0.0.0.0', '192.168.0.1', '::1', 'fc00::1', 'fe80::1',
+                                    '::ffff:127.0.0.1', '2002:7f00:1::', '224.0.0.1',
+                                    '168.63.129.16', '64:ff9b::a00:1'])
+def test_non_public_and_mixed_dns_refused(ip, wire):
+    replies, connections, dns = wire
+    family = socket.AF_INET6 if ':' in ip else socket.AF_INET
+    dns.return_value = [PUBLIC, (family, socket.SOCK_STREAM, 6, '', (ip, 443))]
+    with pytest.raises(h.CaptureHTTPError, match='non_public'):
+        transport().fetch_html(URL)
+    assert not connections
+
+
+def test_success_reads_robots_before_html_and_closes_connections(wire):
+    replies, connections, _ = wire
+    replies.extend([robots(), Response()])
+    assert 'Technical' in transport().fetch_html(URL)
+    assert [c.path for c in connections] == ['/robots.txt', '/article']
+    assert all(c.address == PUBLIC and c.closed for c in connections)
+    assert all(c.headers['Accept-Encoding'] == 'identity' for c in connections)
+
+
+def test_robots_denial_prevents_target_request(wire):
+    replies, connections, _ = wire
+    replies.append(robots(b'User-agent: *\nDisallow: /\n'))
+    with pytest.raises(h.CaptureHTTPError, match='robots_disallow'):
+        transport().fetch_html(URL)
+    assert [c.path for c in connections] == ['/robots.txt']
+
+
+@pytest.mark.parametrize('where', ['robots', 'html'])
+def test_external_redirect_refused_before_next_connection(where, wire):
+    replies, connections, _ = wire
+    redirect = Response(status=302, Location='https://private.example/secret')
+    replies.extend([redirect] if where == 'robots' else [robots(), redirect])
+    with pytest.raises(h.CaptureHTTPError, match='domain_not_allowed'):
+        transport().fetch_html(URL)
+    assert len(connections) == (1 if where == 'robots' else 2)
+
+
+def test_allowed_subdomain_redirect_with_private_dns_refused(wire):
+    replies, connections, dns = wire
+    replies.extend([robots(), Response(status=302, Location='https://sub.manufacturer.example/')])
+    dns.side_effect = lambda host, *a, **kw: [PUBLIC] if host == 'manufacturer.example' else [
+        (socket.AF_INET, socket.SOCK_STREAM, 6, '', ('127.0.0.1', 443))]
+    t = h.Transport(lambda _: True, 'test', 2)
+    with pytest.raises(h.CaptureHTTPError, match='non_public'):
+        t.fetch_html(URL)
+    assert len(connections) == 2
+
+
+def test_same_origin_redirect_rechecks_robots_for_destination(wire):
+    replies, connections, _ = wire
+    replies.extend([robots(), Response(status=302, Location='/forbidden'),
+                    robots(b'User-agent: *\nDisallow: /forbidden\n')])
+    with pytest.raises(h.CaptureHTTPError, match='robots_disallow'):
+        transport().fetch_html(URL)
+    assert [c.path for c in connections] == ['/robots.txt', '/article', '/robots.txt']
+
+
+def test_dns_rebinding_between_robots_and_target_is_refused(wire):
+    replies, connections, dns = wire
+    replies.append(robots())
+    dns.side_effect = [[PUBLIC], [PUBLIC], [(socket.AF_INET, socket.SOCK_STREAM, 6, '', ('127.0.0.1', 443))]]
+    with pytest.raises(h.CaptureHTTPError, match='non_public'):
+        transport().fetch_html(URL)
+    assert len(connections) == 1
+
+
+@pytest.mark.parametrize('response,reason', [
+    (Response(status=401), 'http_status_401'),
+    (Response(status=403), 'http_status_403'),
+    (Response(mime='application/pdf'), 'unsupported_mime'),
+    (Response(mime=None), 'unsupported_mime'),
+    (Response(b'%PDF-1.7 fake HTML'), 'binary_signature'),
+    (Response(b'GIF89a fake HTML'), 'binary_signature'),
+    (Response(b'\x89PNG\x00\x01'), 'binary_body'),
+    (Response(b'<html>\x00</html>'), 'binary_body'),
+    (Response(b'plain text with an HTML MIME'), 'html_signature_missing'),
+    (Response(Content_Encoding='gzip'), 'encoded_body_not_supported'),
+    (Response(Content_Length=999999999), 'invalid_or_oversized'),
+    (Response(Content_Length='invalid'), 'invalid_or_oversized'),
+    (Response(Content_Length=100), 'incomplete_body'),
+    (Response(b'<html>\xff</html>'), 'invalid_text_encoding'),
+])
+def test_unsuitable_body_refused_and_socket_closed(response, reason, wire):
+    replies, connections, _ = wire
+    replies.append(response)
+    with pytest.raises(h.CaptureHTTPError, match=reason):
+        transport().request(URL, 'html')
+    assert all(c.closed for c in connections)
+
+
+def test_streaming_body_limit_without_content_length(wire, monkeypatch):
+    replies, connections, _ = wire
+    monkeypatch.setattr(h, 'MAX_HTML_BYTES', 128)
+    response = Response(b'<html>' + b'x' * 5000)
+    replies.append(response)
+    with pytest.raises(h.CaptureHTTPError, match='body_too_large'):
+        transport().request(URL, 'html')
+    assert response.stream.tell() == 129
+    assert connections[0].closed
+
+
+def test_robots_html_masquerade_refused(wire):
+    wire[0].append(robots(b'<html>login page</html>'))
+    with pytest.raises(h.CaptureHTTPError, match='robots_is_html'):
+        transport().fetch_html(URL)
+    assert len(wire[1]) == 1
+
+
+def test_redirect_loop_and_request_budget_bounded(wire):
+    wire[0].extend(Response(status=302, Location='/robots.txt') for _ in range(h.MAX_REDIRECTS + 1))
+    with pytest.raises(h.CaptureHTTPError, match='robots_redirect_limit'):
+        transport().fetch_html(URL)
+    assert len(wire[1]) == h.MAX_REDIRECTS + 1
+    t = transport()
+    t.requests = h.MAX_REQUESTS
+    with pytest.raises(h.CaptureHTTPError, match='request_budget'):
+        t.request(URL, 'html')
+
+
+def test_expired_deadline_prevents_connection(wire):
+    t = transport()
+    t.deadline = h.time.monotonic() - 1
+    with pytest.raises(h.CaptureHTTPError, match='deadline'):
+        t.request(URL, 'html')
+    assert not wire[1]
+
+
+def test_connection_pins_numeric_address_but_verifies_hostname(monkeypatch):
+    dns = Mock(side_effect=AssertionError('second DNS lookup'))
+    raw = Mock()
+    context = Mock()
+    monkeypatch.setattr(h.socket, 'getaddrinfo', dns)
+    monkeypatch.setattr(h.socket, 'socket', Mock(return_value=raw))
+    monkeypatch.setattr(h.ssl, 'create_default_context', Mock(return_value=context))
+    conn = h._PinnedHTTPSConnection('manufacturer.example', PUBLIC, 2)
+    conn.connect()
+    raw.connect.assert_called_once_with(('93.184.216.34', 443))
+    context.wrap_socket.assert_called_once_with(raw, server_hostname='manufacturer.example')
+    dns.assert_not_called()
+
+
+def test_tls_error_closes_raw_socket(monkeypatch):
+    raw = Mock()
+    context = Mock()
+    context.wrap_socket.side_effect = h.ssl.SSLError('certificate invalid')
+    monkeypatch.setattr(h.socket, 'socket', Mock(return_value=raw))
+    monkeypatch.setattr(h.ssl, 'create_default_context', Mock(return_value=context))
+    with pytest.raises(h.ssl.SSLError):
+        h._PinnedHTTPSConnection('manufacturer.example', PUBLIC, 2).connect()
+    raw.close.assert_called_once()
+
+
+def test_real_runner_network_refusal_leaves_no_raw_source(wire, monkeypatch, tmp_path):
+    spec = importlib.util.spec_from_file_location('runner_network_test', Path(__file__).parents[1] / 'auto-capture-runner.py')
+    runner = importlib.util.module_from_spec(spec)
