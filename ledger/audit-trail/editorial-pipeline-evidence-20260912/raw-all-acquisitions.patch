+"""Bounded HTTPS transport for the existing RAW HTML capture runner.
+
+No proxy, cookies, auth or automatic redirects. DNS is checked once per request;
+the TCP socket connects to that exact checked address, retaining hostname TLS
+verification. robots.txt uses the same transport. Direct video acquisition uses the same request controls and temporary storage.
+
+Operational bounds: 2 MiB HTML, 64 MiB direct video, 256 KiB robots, four redirects per resource,
+12 requests per capture, identity encoding only. bounded_network enforces a 90 s
+process deadline, including blocked OS DNS and HTTP header parsing. This transport does not attest licenses,
+paywall-free content, editorial relevance, or source-score eligibility.
+"""
+from __future__ import annotations
+
+import http.client
+import ctypes
+import hashlib
+import json
+import multiprocessing
+import os
+import signal
+import tempfile
+from contextlib import ExitStack
+from pathlib import Path
+import ipaddress
+import re
+import socket
+import ssl
+import time
+from urllib.parse import urljoin, urlsplit, urlunsplit
+from urllib.robotparser import RobotFileParser
+
+MAX_HTML_BYTES = 2 * 1024 * 1024
+MAX_MEDIA_BYTES = 64 * 1024 * 1024
+MEDIA_MIMES = {
+    "video/mp4": "mp4", "video/x-m4v": "mp4", "video/quicktime": "mov",
+    "video/webm": "webm", "video/x-matroska": "mkv",
+}
+MAX_ROBOTS_BYTES = 256 * 1024
+MAX_REDIRECTS = 4
+MAX_REQUESTS = 12
+_FORBIDDEN_V6_TRANSLATION = (ipaddress.ip_network("64:ff9b::/96"), ipaddress.ip_network("64:ff9b:1::/48"))
+TOTAL_TIMEOUT = 90
+_REDIRECTS = {301, 302, 303, 307, 308}
+
+
+class CaptureHTTPError(ValueError):
+    """The response cannot safely enter the HTML capture pipeline."""
+
+
+
+
+def media_extension(prefix, mime):
+    """Match the declared type to the container header, independent of URL suffix."""
+    expected = MEDIA_MIMES[mime]
+    if expected in ("mp4", "mov"):
+        if len(prefix) < 16 or prefix[4:8] != b"ftyp":
+            raise CaptureHTTPError("media_signature_mismatch")
+        actual = "mov" if prefix[8:12] == b"qt  " else "mp4"
+    else:
+        if prefix[:4] != b"\x1a\x45\xdf\xa3":
+            raise CaptureHTTPError("media_signature_mismatch")
+        def vint(offset, *, identifier=False):
+            first = prefix[offset]
+            width = next((n for n in range(1, 9) if first & (1 << (8 - n))), 0)
+            if not width or offset + width > len(prefix):
+                raise ValueError("invalid_ebml")
+            value = int.from_bytes(prefix[offset:offset + width], "big")
+            return (value if identifier else value & ((1 << (7 * width)) - 1)), offset + width
+        try:
+            size, offset = vint(4)
+            end = offset + size
+            if end > len(prefix):
+                raise ValueError("oversized_ebml_header")
+            actual = None
+            while offset < end:
+                element, offset = vint(offset, identifier=True)
+                size, offset = vint(offset)
+                if offset + size > end:
+                    raise ValueError("invalid_ebml_element")
+                if element == 0x4282:
+                    actual = {b"webm": "webm", b"matroska": "mkv"}.get(bytes(prefix[offset:offset + size]))
+                offset += size
+        except (ValueError, IndexError):
+            raise CaptureHTTPError("media_signature_mismatch") from None
+    if actual != expected:
+        raise CaptureHTTPError("media_mime_container_mismatch")
+    return actual
+
+
+def _network_worker(action, result_path, parent_pid):
+    # A killed caller must not leave an orphan DNS/HTTP worker behind (Linux VPS).
+    if ctypes.CDLL(None).prctl(1, signal.SIGKILL, 0, 0, 0) != 0:
+        raise RuntimeError("parent_death_guard_unavailable")
+    if os.getppid() != parent_pid:
+        return
+    try:
+        result = {"ok": True, "value": action()}
+    except Exception as exc:
+        result = {"ok": False, "error": str(exc) if isinstance(exc, CaptureHTTPError) else type(exc).__name__}
+    Path(result_path).write_text(json.dumps(result, ensure_ascii=False), encoding="utf-8")
+
+
+def bounded_network(action, *, timeout=TOTAL_TIMEOUT):
+    """Hard process deadline also covers blocked OS DNS and HTTP header reads.
+
+    The child only downloads into temporary storage. Durable publication remains
+    in the caller after validation. No pipe recv can block after the join timeout.
+    """
+    with tempfile.TemporaryDirectory(prefix="raw-network-result-") as tmp:
+        result_path = Path(tmp) / "result.json"
+        worker = multiprocessing.get_context("fork").Process(
+            target=_network_worker, args=(action, str(result_path), os.getpid()))
+        worker.start()
+        try:
+            worker.join(timeout)
+            if worker.is_alive():
+                worker.kill()
+                worker.join(2)
+                raise CaptureHTTPError("network_deadline_exceeded")
+            if worker.exitcode != 0 or not result_path.exists():
+                raise CaptureHTTPError("network_worker_failed")
+            result = json.loads(result_path.read_text(encoding="utf-8"))
+            if not result["ok"]:
+                raise CaptureHTTPError(result["error"])
+            return result["value"]
+        finally:
+            if worker.is_alive():
+                worker.kill()
+                worker.join(2)
+
+
+def _target(url, allowed):
+    if not isinstance(url, str) or re.search(r"[\x00-\x20\x7f\\]", url):
+        raise CaptureHTTPError("invalid_url")
+    try:
+        parsed = urlsplit(url)
+        host = (parsed.hostname or "").encode("idna").decode("ascii").lower()
+        if (parsed.scheme != "https" or not host or parsed.username is not None
+                or parsed.password is not None or parsed.port not in (None, 443)):
+            raise CaptureHTTPError("https_public_origin_required")
+    except (ValueError, UnicodeError) as exc:
+        raise CaptureHTTPError("invalid_https_url") from exc
+    if not allowed(url):
+        raise CaptureHTTPError("domain_not_allowed")
+    addresses = socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
+    if not addresses:
+        raise CaptureHTTPError("dns_empty")
+    for family, socktype, proto, canonname, sockaddr in addresses:
+        ip = ipaddress.ip_address(sockaddr[0])
+        if (not ip.is_global or ip.is_multicast or ip.is_unspecified
+                or str(ip) == "168.63.129.16"
+                or (ip.version == 6 and any(ip in net for net in _FORBIDDEN_V6_TRANSLATION))
+                or (ip.version == 6 and (ip.ipv4_mapped or ip.sixtofour or ip.teredo))):
+            raise CaptureHTTPError("non_public_address")
+        if family not in (socket.AF_INET, socket.AF_INET6):
+            raise CaptureHTTPError("unsupported_address_family")
+    path = urlunsplit(("", "", parsed.path or "/", parsed.query, ""))
+    return host, path, addresses[0]
+
+
+class _PinnedHTTPSConnection(http.client.HTTPSConnection):
+    def __init__(self, host, address, timeout):
+        super().__init__(host, 443, timeout=timeout, context=ssl.create_default_context())
+        self.address = address
+
+    def connect(self):
+        family, socktype, proto, _, sockaddr = self.address
+        raw = socket.socket(family, socktype, proto)
+        try:
+            raw.settimeout(self.timeout)
+            raw.connect(sockaddr)  # numeric sockaddr: no second DNS resolution
+            self.sock = self._context.wrap_socket(raw, server_hostname=self.host)
+        except BaseException:
+            raw.close()
+            raise
+
+
+class Transport:
+    def __init__(self, allowed, user_agent, timeout, rate_limit=0):
+        self.allowed = allowed
+        self.user_agent = user_agent
+        self.timeout = timeout
+        self.rate_limit = max(0, rate_limit)
+        self.deadline = time.monotonic() + TOTAL_TIMEOUT
+        self.requests = 0
+        self.last_request = None
+
+    def remaining(self):
+        remaining = self.deadline - time.monotonic()
+        if remaining <= 0:
+            raise CaptureHTTPError("capture_deadline_exceeded")
+        return min(self.timeout, remaining)
+
+    def request(self, url, kind, destination=None):
+        if self.requests >= MAX_REQUESTS:
+            raise CaptureHTTPError("request_budget_exceeded")
+        self.remaining()
+        host, path, address = _target(url, self.allowed)
+        if self.last_request is not None:
+            delay = max(0, self.rate_limit - (time.monotonic() - self.last_request))
+            if delay >= self.deadline - time.monotonic():
+                raise CaptureHTTPError("capture_deadline_exceeded")
+            time.sleep(delay)
+        conn = _PinnedHTTPSConnection(host, address, self.remaining())
+        self.requests += 1
+        self.last_request = time.monotonic()
+        try:
+            conn.request("GET", path, headers={"User-Agent": self.user_agent,
+                         "Accept-Encoding": "identity", "Accept": ", ".join(MEDIA_MIMES) if kind == "media" else ("text/html, application/xhtml+xml" if kind == "html" else "text/plain")})
+            resp = conn.getresponse()
+            if resp.status in _REDIRECTS:
+                location = resp.getheader("Location")
+                if not location:
+                    raise CaptureHTTPError("redirect_without_location")
+                return urljoin(url, location), None
+            if resp.status != 200:
+                raise CaptureHTTPError(f"http_status_{resp.status}")
+            if resp.getheader("Content-Encoding", "identity").lower() != "identity":
+                raise CaptureHTTPError("encoded_body_not_supported")
+            mime = resp.headers.get_content_type()
+            allowed_mimes = set(MEDIA_MIMES) if kind == "media" else ({"text/html", "application/xhtml+xml"} if kind == "html" else {"text/plain"})
+            if mime not in allowed_mimes or not resp.getheader("Content-Type"):
+                raise CaptureHTTPError("unsupported_mime")
+            limit = MAX_MEDIA_BYTES if kind == "media" else (MAX_HTML_BYTES if kind == "html" else MAX_ROBOTS_BYTES)
+            length = resp.getheader("Content-Length")
+            if length is not None and (not length.isdigit() or int(length) > limit):
+                raise CaptureHTTPError("invalid_or_oversized_content_length")
+            data = bytearray()
+            count = 0
+            digest = hashlib.sha256()
+            with ExitStack() as stack:
+                output = stack.enter_context(Path(destination).open("xb")) if kind == "media" else None
+                while count <= limit:
+                    if conn.sock is not None:
+                        conn.sock.settimeout(self.remaining())
+                    else:
+                        self.remaining()
+                    chunk = resp.read1(min(65536, limit + 1 - count))
+                    if not chunk:
+                        break
+                    count += len(chunk)
+                    if output is not None:
+                        output.write(chunk)
+                        digest.update(chunk)
+                        data.extend(chunk[:max(0, 4096 - len(data))])
+                    else:
+                        data.extend(chunk)
+                self.remaining()
+                if count > limit:
+                    raise CaptureHTTPError("body_too_large")
+                if length is not None and count != int(length):
+                    raise CaptureHTTPError("incomplete_body")
+                if output is not None:
+                    extension = media_extension(data, mime)
+                    output.flush()
+                    os.fsync(output.fileno())
+                    return None, {"mime": mime, "ext": extension, "size_bytes": count,
+                                  "media_hash": "sha256:" + digest.hexdigest()}
+            # Declared MIME alone is insufficient. Reject binary controls/magic and
+            # require HTML syntax (robots must be text, never an HTML login page).
+            if any(byte < 32 and byte not in (9, 10, 13) for byte in data):
+                raise CaptureHTTPError("binary_body")
+            charset = resp.headers.get_content_charset() or "utf-8"
+            try:
+                text = bytes(data).decode(charset, errors="strict")
+            except (LookupError, UnicodeError) as exc:
+                raise CaptureHTTPError("invalid_text_encoding") from exc
+            prefix = text.lstrip("\ufeff \t\r\n")[:1024].lower()
+            if prefix.startswith(("%pdf-", "pk", "gif8", "\x89png")):
+                raise CaptureHTTPError("binary_signature")
+            if kind == "html" and not re.search(r"<(?:!doctype\s+html|html|head|body|article|p|h[1-6])(?:\s|>)", prefix):
+                raise CaptureHTTPError("html_signature_missing")
+            if kind == "robots" and re.search(r"<(?:!doctype|html|head|body)(?:\s|>)", prefix):
+                raise CaptureHTTPError("robots_is_html")
+            return None, text
+        finally:
+            conn.close()
+
+    def robots_ok(self, url):
+        parsed = urlsplit(url)
+        current = urlunsplit((parsed.scheme, parsed.netloc, "/robots.txt", "", ""))
+        for _ in range(MAX_REDIRECTS + 1):
+            redirect, body = self.request(current, "robots")
+            if redirect is None:
+                parser = RobotFileParser()
+                parser.parse(body.splitlines())
+                return parser.can_fetch(self.user_agent, url)
+            current = redirect
+        raise CaptureHTTPError("robots_redirect_limit")
+
+    def _fetch_resource(self, url, kind, destination=None):
+        current = url
+        chain = []
+        for _ in range(MAX_REDIRECTS + 1):
+            _target(current, self.allowed)
+            if not self.robots_ok(current):
+                raise CaptureHTTPError("robots_disallow")
+            redirect, body = self.request(current, kind, destination)
+            chain.append(current)
+            if redirect is None:
+                if kind == "media":
+                    body.update(final_url=current, redirect_chain=chain)
+                return body
+            current = redirect
+        raise CaptureHTTPError(f"{kind}_redirect_limit")
+
+    def fetch_html(self, url):
+        return self._fetch_resource(url, "html")
+
+    def fetch_media(self, url, destination):
+        return self._fetch_resource(url, "media", destination)
