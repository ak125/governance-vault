+def test_hard_deadline_kills_a_blocked_dns_worker(wire):
+    import os
+    import time
+    wire[2].side_effect = lambda *a, **kw: __import__("threading").Event().wait(10)
+    started = time.monotonic()
+    with pytest.raises(h.CaptureHTTPError, match='network_deadline'):
+        h.bounded_network(lambda: transport().fetch_html(URL), timeout=0.1)
+    assert time.monotonic() - started < 2
+    assert not h.multiprocessing.active_children()
+
