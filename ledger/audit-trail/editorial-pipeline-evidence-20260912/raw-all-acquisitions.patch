+@contextmanager
+def acquisition_lock():
+    """One nonblocking lock for all native capture writers in this checkout."""
+    import fcntl
+    lock_path = subprocess.run(["git", "-C", str(REPO_ROOT), "rev-parse", "--git-path", "raw-admin-acquisition.lock"],
+                               capture_output=True, text=True, timeout=5, check=True).stdout.strip()
+    lock = Path(lock_path)
+    if not lock.is_absolute():
+        lock = REPO_ROOT / lock
+    with lock.open("a") as held:
+        fcntl.flock(held, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        yield
+
