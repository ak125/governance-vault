+def test_hard_deadline_kills_blocked_http_headers(wire, monkeypatch):
+    import time
+    class Blocked:
+        def __init__(self, *args):
+            pass
+        def request(self, *args, **kwargs):
+            pass
+        def getresponse(self):
+            __import__("threading").Event().wait(10)
+        def close(self):
+            pass
+    monkeypatch.setattr(h, '_PinnedHTTPSConnection', Blocked)
+    with pytest.raises(h.CaptureHTTPError, match='network_deadline'):
+        h.bounded_network(lambda: transport().request(URL, 'html'), timeout=0.1)
+    assert not h.multiprocessing.active_children()
+
