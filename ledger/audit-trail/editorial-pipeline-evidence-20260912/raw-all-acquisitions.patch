+@exclusive_capture
+def ingest_admin_submission(doc: dict, *, commit: bool) -> dict:
+    """Receive declared text as recycled/unverified, never as a verified URL fetch.
+
+    Client decisions and truth levels are not accepted by this producer. Same
+    declared source + exact body yields the same immutable receipt; a changed
+    body is a new version. Native manifests must succeed before RECEIVED.
+    """
+    import jsonschema
+    from urllib.parse import urlsplit, urlunsplit
+
+    allowed = {"title", "content", "source", "source_url", "domain", "category"}
+    if not isinstance(doc, dict) or set(doc) - allowed:
+        raise ValueError("invalid_submission_fields")
+    for key in ("title", "content", "source"):
+        if not isinstance(doc.get(key), str) or not doc[key].strip():
+            raise ValueError(f"submission_missing_{key}")
+    if any(not isinstance(value, str) or "\x00" in value for value in doc.values()):
+        raise ValueError("invalid_submission_value")
+    if len(json.dumps(doc, ensure_ascii=False).encode("utf-8")) > 1024 * 1024:
+        raise ValueError("submission_too_large")
+    if any(pat.search(json.dumps(doc, ensure_ascii=False)) for pat in _gates._AC_PII_PATTERNS):
+        raise ValueError("submission_possible_pii")
+    source_key = doc["source"].strip()
+    if doc.get("source_url"):
+        parsed = urlsplit(doc["source_url"])
+        if parsed.scheme != "https" or not parsed.hostname or parsed.username is not None or parsed.password is not None:
+            raise ValueError("invalid_declared_source_url")
+        port = parsed.port
+        host = parsed.hostname.lower()
+        if ":" in host:
+            host = "[" + host + "]"
+        netloc = host if port in (None, 443) else f"{host}:{port}"
+        source_key = urlunsplit(("https", netloc, parsed.path or "/", parsed.query, ""))
+    content_hash = "sha256:" + hashlib.sha256(doc["content"].encode("utf-8")).hexdigest()
+    receipt_id = hashlib.sha256(json.dumps([source_key, content_hash], ensure_ascii=False).encode("utf-8")).hexdigest()
+    raw_path = f"recycled/admin-submissions/{receipt_id}.md"
+    out_path = REPO_ROOT / raw_path
+    if not out_path.resolve().is_relative_to(REPO_ROOT.resolve() / "recycled" / "admin-submissions"):
+        raise ValueError("submission_path_escape")
+    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    fm = {
+        "title": doc["title"], "source_type": "admin_submission", "truth_level": "L4",
+        "verification_status": "to_verify", "created_at": now, "updated_at": now,
+        "origin_repo": "nestjs-remix-monorepo", "origin_path": "api/rag/admin/cleanup/apply",
+        "origin_type": "admin_submission", "source_level": "secondary", "trust_level": "to_verify",
+        "status": "recycled", "can_feed_wiki": True, "can_feed_content_directly": False,
+        "can_feed_chatbot_directly": False, "recycled_at": now[:10],
+        "doc_id": str(uuid.uuid5(uuid.NAMESPACE_URL, "admin-submission:" + receipt_id)),
+        "content_hash": content_hash, "source_identity_hash": "sha256:" + hashlib.sha256(source_key.encode("utf-8")).hexdigest(),
+        "declared_source": doc["source"],
+        "source_url_verified": False, "acquisition_method": "submitted_text",
+    }
+    if doc.get("source_url"):
+        fm["source_url"] = source_key
+    for key in ("domain", "category"):
+        if key in doc:
+            fm["declared_" + key] = doc[key]
+    schema = json.loads(_gates.RECYCLED_FM_SCHEMA.read_text(encoding="utf-8"))
+    jsonschema.Draft202012Validator.check_schema(schema)
+    jsonschema.Draft202012Validator(schema).validate(fm)
+    candidate = build_frontmatter(fm) + "\n" + doc["content"]
+    receipt = {"id": receipt_id, "destination": "raw", "raw_path": raw_path,
+               "content_hash": content_hash, "status": "to_verify", "retrievable": False,
+               "duplicate": False, "action": "PLAN"}
+    if not commit:
+        return receipt
+    check_submission_secrets(candidate)
+    # exclusive_capture holds the common writer lock through validation and manifests.
+    if out_path.exists():
+        existing = out_path.read_text(encoding="utf-8")
+        match = _gates.FRONTMATTER_RE.match(existing)
+        if not match or existing[len(match.group(0)):].removeprefix("\n") != doc["content"]:
+            raise ValueError("submission_receipt_collision")
+        old = _gates._split_frontmatter(existing)
+        if old.get("content_hash") != content_hash or old.get("doc_id") != fm["doc_id"]:
+            raise ValueError("submission_receipt_collision")
+        receipt["duplicate"] = True
+    else:
+        publish_append_only(out_path, candidate)
+    # On failure preserve immutable source. Retrying the same request repairs
+    # its manifests before returning success, never creates another source.
+    refresh_submission_manifests()
+    receipt["action"] = "RECEIVED"
+    return receipt
