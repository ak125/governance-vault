+"""Native RAW gates and manifests; network/probe fixtures never contact a source."""
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from .test_admin_submission import producer
+
+URL = 'https://www.bosch.com/technical.mp4'
+
+
+@pytest.fixture
+def video(producer, monkeypatch):
+    runner, root = producer
+    state = {'body': b'fixture-container-one', 'fetches': 0}
+    entry = {'level': 2, 'source_type': 'product_catalog', 'license_status': 'unknown'}
+    # Fixture source policy, not a production allowlist extension.
+    monkeypatch.setattr(runner, 'load_allowlist', lambda: {})
+    monkeypatch.setattr(runner, 'classify', lambda *_: ('allow', entry))
+    monkeypatch.setattr(runner._http, 'bounded_network', lambda fn: fn())
+    def fetch(url, destination):
+        state['fetches'] += 1
+        destination.write_bytes(state['body'])
+        return {'ext': 'mp4', 'mime': 'video/mp4', 'size_bytes': len(state['body']),
+                'media_hash': 'sha256:' + hashlib.sha256(state['body']).hexdigest(),
+                'final_url': url, 'redirect_chain': [url]}
+    monkeypatch.setattr(runner, '_transport', lambda *_: SimpleNamespace(fetch_media=fetch))
+    monkeypatch.setattr(runner, 'probe_video', lambda *_: {'duration_sec': 1.0, 'video_streams': [{'codec': 'h264', 'width': 16, 'height': 16}]})
+    return runner, root, state
+
+
+def test_native_inventory_and_replay_preserve_all_bytes(video):
+    r, root, state = video
+    first = r.ingest_admin_video({'url': URL, 'gamme': 'freinage'}, commit=True)
+    assert first['destination'] == 'raw' and first['retrievable'] is False
+    assert first['status'] == 'to_verify' and not first['duplicate']
+    before = {p: (p.read_bytes(), p.stat().st_mtime_ns) for p in (root / 'sources').rglob('*') if p.is_file()}
+    second = r.ingest_admin_video({'url': URL, 'gamme': 'declaration changed'}, commit=True)
+    assert second['duplicate'] and second['id'] == first['id']
+    assert all((p.read_bytes(), p.stat().st_mtime_ns) == value for p, value in before.items())
+    checksums = json.loads((root / 'manifests/checksums.json').read_text())
+    assert first['raw_path'] in checksums and first['media_path'] in checksums
+    checked = subprocess.run(['python3', str(root / '_scripts/regen-manifests.py'), '--check'], capture_output=True)
+    assert checked.returncode == 0, checked.stderr
+    assert r._gates.gate_auto_capture()[0] == []
+
+
+def test_changed_content_versions_and_two_sources_one_binary(video):
+    r, root, state = video
+    first = r.ingest_admin_video({'url': URL}, commit=True)
+    original = (root / first['raw_path']).read_bytes()
+    other = r.ingest_admin_video({'url': URL + '?mirror=2'}, commit=True)
+    assert other['id'] != first['id'] and other['media_path'] == first['media_path']
+    state['body'] = b'fixture-container-two'
+    changed = r.ingest_admin_video({'url': URL}, commit=True)
+    assert changed['id'] != first['id'] and changed['media_path'] != first['media_path']
+    assert (root / first['raw_path']).read_bytes() == original
+    assert len(list((root / 'sources/media').glob('*.mp4'))) == 2
+    assert len(list((root / 'sources/auto-captures/media').glob('*.md'))) == 3
+
+
+@pytest.mark.parametrize('failure', ['probe_video', 'check_submission_secrets'])
+def test_refusal_before_durable_write(video, monkeypatch, failure):
+    r, root, _ = video
+    monkeypatch.setattr(r, failure, lambda *_: (_ for _ in ()).throw(ValueError('refused')))
+    with pytest.raises(ValueError):
+        r.ingest_admin_video({'url': URL}, commit=True)
+    assert not (root / 'sources').exists()
+
+
+@pytest.mark.parametrize('failure', ['sidecar', 'manifests'])
+def test_partial_failure_preserves_binary_and_retry_repairs(video, monkeypatch, failure):
+    r, root, state = video
+    publish = r.publish_append_only
+    def failed(path, candidate):
+        if path.name.endswith('.manifest.yaml'):
+            raise OSError('fixture disk failure')
+        publish(path, candidate)
+    with monkeypatch.context() as patcher:
+        if failure == 'sidecar':
+            patcher.setattr(r, 'publish_append_only', failed)
+        else:
+            patcher.setattr(r, 'refresh_submission_manifests', lambda: (_ for _ in ()).throw(RuntimeError('fixture manifest failure')))
+        with pytest.raises((OSError, RuntimeError)):
+            r.ingest_admin_video({'url': URL}, commit=True)
+    binary = next((root / 'sources/media').glob('*.mp4'))
+    before = binary.read_bytes(), binary.stat().st_mtime_ns
+    repaired = r.ingest_admin_video({'url': URL}, commit=True)
+    assert repaired['action'] == 'RECEIVED'
+    assert (binary.read_bytes(), binary.stat().st_mtime_ns) == before
+    assert repaired['raw_path'] in json.loads((root / 'manifests/checksums.json').read_text())
+
+
+def test_lock_refuses_before_network_and_plan_does_not_fetch(video):
+    r, root, state = video
+    with r.acquisition_lock():
+        with pytest.raises(BlockingIOError):
+            r.ingest_admin_video({'url': URL}, commit=True)
+        assert r.ingest_admin_video({'url': URL}, commit=False)['action'] == 'PLAN'
+    assert state['fetches'] == 0 and not (root / 'sources').exists()
+
+
+def test_sidecar_symlink_escape_refused_without_external_write(video, tmp_path):
+    r, root, state = video
+    directory = root / 'sources/media'
+    directory.mkdir(parents=True)
+    digest = hashlib.sha256(state['body']).hexdigest()
+    outside = root / 'outside.yaml'
+    (directory / (digest + '.mp4.manifest.yaml')).symlink_to(outside)
+    with pytest.raises(ValueError, match='path_escape'):
+        r.ingest_admin_video({'url': URL}, commit=True)
+    assert not outside.exists()
+
+
+def test_binary_collision_never_overwrites(video):
+    r, root, state = video
+    receipt = r.ingest_admin_video({'url': URL}, commit=True)
+    binary = root / receipt['media_path']
+    binary.write_bytes(b'fixture corruption')
+    with pytest.raises(ValueError, match='binary_collision'):
+        r.ingest_admin_video({'url': URL}, commit=True)
+    assert binary.read_bytes() == b'fixture corruption'
