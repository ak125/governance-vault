+def publish_append_only(out_path: Path, candidate: str | Path) -> None:
+    """Existing atomic publication, shared by URL capture and submitted text."""
+    staging_path = None
+    try:
+        out_path.parent.mkdir(parents=True, exist_ok=True)
+        binary = isinstance(candidate, Path)
+        with tempfile.NamedTemporaryFile(mode="wb" if binary else "w", encoding=None if binary else "utf-8", dir=out_path.parent,
+                                         prefix=".capture-", suffix=".tmp", delete=False) as staged:
+            staging_path = Path(staged.name)
+            if binary:
+                with candidate.open("rb") as source:
+                    shutil.copyfileobj(source, staged, length=65536)
+            else:
+                staged.write(candidate)
+            staged.flush()
+            os.fsync(staged.fileno())
+        os.link(staging_path, out_path)
+    finally:
+        if staging_path is not None:
+            staging_path.unlink()
