+"""Actual importer loop and strict Pydantic schema, in-memory collection only."""
+import hashlib
+import shutil
+import sys
+from types import ModuleType, SimpleNamespace
+
+import frontmatter
+import pytest
+
+from scripts.importers import import_wiki_exports as importer
+
+
+@pytest.fixture
+def pipeline(tmp_path, monkeypatch):
+    root = tmp_path / 'wiki'
+    exports = root / 'exports/rag/gamme'
+    exports.mkdir(parents=True)
+    path = exports / 'plaquette-de-frein.md'
+    shutil.copyfile(__import__('pathlib').Path(__file__).parent / 'fixtures/wiki_exports/gamme/valid-plaquette-de-frein.md', path)
+    original = frontmatter.load(path)
+    original['content_hash'] = hashlib.sha256(original.content.encode()).hexdigest()
+    path.write_text(frontmatter.dumps(original))
+    rows = []
+    calls = []
+    collection = SimpleNamespace(data=SimpleNamespace(insert=lambda *, properties, uuid=None: rows.append(properties)))
+    client = SimpleNamespace(collections=SimpleNamespace(get=lambda _: collection, exists=lambda _: True))
+    config = ModuleType('app.config')
+    config.get_settings = lambda: SimpleNamespace(embedding_model='fixture-no-embedding')
+    weaviate = ModuleType('app.services.weaviate_client')
+    weaviate.WeaviateClient = lambda: SimpleNamespace(client=client)
+    monkeypatch.setitem(sys.modules, 'app.config', config)
+    monkeypatch.setitem(sys.modules, 'app.services.weaviate_client', weaviate)
+    monkeypatch.setattr(importer, 'WIKI_PATH', root)
+    monkeypatch.setattr(importer, 'QUARANTINE_DIR', tmp_path / 'quarantine')
+    monkeypatch.setattr(importer, 'assert_wiki_path_valid', lambda: root / 'exports/rag')
+    monkeypatch.setattr(importer, 'get_wiki_head_commit', lambda: 'fixture-commit')
+    def exists(_client, **identity):
+        calls.append(identity)
+        return any(all(row.get(key) == value for key, value in identity.items()) for row in rows)
+    monkeypatch.setattr(importer, 'chunk_already_in_v2', exists)
+    def reconcile(_client, *, source_path, content_hash):
+        stale = [row for row in rows if row.get('canonical_source') == importer.CANONICAL_SOURCE_WIKI
+                 and row.get('source_layer') == importer.SOURCE_LAYER_EXPORTS_RAG
+                 and row.get('origin_batch_kind') == importer.ORIGIN_BATCH_KIND_WIKI
+                 and row.get('source_path') == source_path and row.get('content_hash') != content_hash]
+        for row in stale:
+            rows.remove(row)
+        return len(stale)
+    monkeypatch.setattr(importer, 'retire_replaced_versions', reconcile, raising=False)
+    return path, rows, calls
+
+
+def run():
+    return importer.run(apply=True, entity_filter=None, limit=None, force_reembedding=False)
+
