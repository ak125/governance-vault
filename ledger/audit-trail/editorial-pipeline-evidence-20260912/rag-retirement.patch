+def test_import_preserves_real_markdown_body_and_skips_unchanged_replay(pipeline):
+    path, rows, calls = pipeline
+    expected = frontmatter.load(path).content
+    assert run()['imported'] == 1
+    assert rows[0]['content'] == expected
+    assert expected.strip()
+    assert run()['skipped_idempotent'] == 1
+    assert len(rows) == 1 and len(calls) == 2
+
