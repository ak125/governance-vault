+"""Confirmed, bounded deletion shared by existing index consumers.
+
+Filter equality on Weaviate text can be tokenized. Recheck exact properties in
+Python and delete only the UUIDs of matching objects, never a textual bulk filter.
+No scheduler, persistence, new collection or producer is introduced here.
+"""
+from typing import Any
+
+
+def retire_exact_objects(collection, *, identity: dict[str, Any],
+                         different_hash: str | None = None) -> int:
+    from weaviate.classes.query import Filter
+
+    if not identity or any(value in (None, '') for value in identity.values()):
+        raise ValueError('Retirement requires a complete identity')
+    where = None
+    for key, value in identity.items():
+        clause = Filter.by_property(key).equal(value)
+        where = clause if where is None else where & clause
+    if different_hash is not None:
+        where = where & Filter.by_property('content_hash').not_equal(different_hash)
+
+    def exact(obj):
+        props = obj.properties
+        return (all(props.get(key) == value for key, value in identity.items())
+                and (different_hash is None or
+                     (bool(props.get('content_hash')) and props['content_hash'] != different_hash)))
+
+    def candidates():
+        objects = collection.query.fetch_objects(filters=where, limit=201).objects
+        if len(objects) > 200:
+            raise RuntimeError('Retirement exceeds bounded scope (200 objects); explicit reconciliation required')
+        return [obj for obj in objects if exact(obj)]
+
+    selected = candidates()
+    for obj in selected:
+        collection.data.delete_by_id(obj.uuid)
+    if candidates():
+        raise RuntimeError('Index retirement incomplete: exact objects remain')
+    return len(selected)
