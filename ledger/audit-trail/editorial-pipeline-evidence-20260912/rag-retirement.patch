+class Predicate:
+    def __init__(self, fn):
+        self.fn = fn
+    def __and__(self, other):
+        return Predicate(lambda row: self.fn(row) and other.fn(row))
+
+
+class Property:
+    def __init__(self, key):
+        self.key = key
+    def equal(self, value):
+        return Predicate(lambda row: row.get(self.key) == value)
+    def not_equal(self, value):
+        return Predicate(lambda row: self.key in row and row[self.key] != value)
+
