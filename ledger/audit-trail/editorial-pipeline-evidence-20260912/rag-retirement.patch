+def test_new_version_retires_previous_hash_and_preserves_other_sources(pipeline):
+    path, rows, _ = pipeline
+    run()
+    untouched = dict(rows[0], source_path='exports/rag/gamme/disque-de-frein.md')
+    rows.append(untouched)
+    post = frontmatter.load(path)
+    post.content = 'Version remplaçante validée.'
+    post['content_hash'] = hashlib.sha256(post.content.encode()).hexdigest()
+    path.write_text(frontmatter.dumps(post))
+    result = run()
+    assert result['retired_replaced'] == 1
+    assert len(rows) == 2 and untouched in rows
+    assert [r['content'] for r in rows if r is not untouched] == [post.content]
+    assert run()['retired_replaced'] == 0
+    assert len(rows) == 2
