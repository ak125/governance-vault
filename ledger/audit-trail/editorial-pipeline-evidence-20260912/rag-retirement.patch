+def test_replay_finishes_retirement_after_interrupted_cleanup(pipeline, monkeypatch):
+    path, rows, _ = pipeline
+    run()
+    post = frontmatter.load(path)
+    post.content = 'Version après interruption.'
+    post['content_hash'] = hashlib.sha256(post.content.encode()).hexdigest()
+    path.write_text(frontmatter.dumps(post))
+    reconcile = importer.retire_replaced_versions
+    def interrupted(*args, **kwargs):
+        raise OSError('simulated index interruption')
+    monkeypatch.setattr(importer, 'retire_replaced_versions', interrupted)
+    result = run()
+    assert result['errors'] == 1 and not result['success']
+    assert len(rows) == 2
+    monkeypatch.setattr(importer, 'retire_replaced_versions', reconcile)
+    result = run()
+    assert result['skipped_idempotent'] == 1 and result['retired_replaced'] == 1
+    assert result['success'] and len(rows) == 1
+
