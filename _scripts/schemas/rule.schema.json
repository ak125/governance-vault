{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automecanik.com/governance-vault/schemas/rule.schema.json",
  "title": "Rule document frontmatter (optional)",
  "description": "Frontmatter YAML pour les documents rules-*.md. Certaines rules historiques n'ont pas de frontmatter (traite en warning, non-bloquant). Si frontmatter present, doit matcher ce schema.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "rule",
        "rules-document"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "canon",
        "draft",
        "deprecated",
        "superseded"
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "version": {
      "type": "string"
    },
    "superseded_by": {
      "type": [
        "array",
        "string",
        "null"
      ]
    }
  }
}
